# Supabase Database & Auth (Lovable Cloud / Supabase integration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public browser environment (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# AI Assistant
LOVABLE_API_KEY=
GEMINI_API_KEY=

# Email (Resend)
MENELOG_RESEND_API_KEY=
MENELOG_EMAIL_FROM="Mene:Log <support@menelog.site>"

# SMS & WhatsApp (Twilio or Arkesel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=MeneLog

# Payments (Paystack)
PAYSTACK_SECRET_KEY=

# Scheduled Cron Security
MENELOG_CRON_SECRET=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
